# Application
APP_NAME=landslide-system
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_DB=landslide
POSTGRES_USER=landslide_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Weather / Rainfall APIs
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# Satellite / Earth Engine
GOOGLE_CLOUD_PROJECT=
EARTH_ENGINE_PROJECT=

# ML
MODEL_PATH=
MODEL_VERSION=v1

# Alerts
ALERT_ENABLED=false
ALERT_PROVIDER=
ALERT_API_KEY=

# Satellite pipeline
# Directory for caching downloaded satellite imagery
SATELLITE_CACHE_DIR=.satellite_cache
# Version tag stamped on every satellite output record
SATELLITE_PROCESSING_VERSION=v1
# Target output pixel resolution in metres (Sentinel-2: 10)
SATELLITE_SPATIAL_RESOLUTION_M=10
# Maximum cloud cover fraction to accept [0.0-1.0]
SATELLITE_CLOUD_THRESHOLD=0.30
